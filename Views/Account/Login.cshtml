@model LoginInput
@{ ViewData["Title"] = "Đăng nhập"; }
<div class="mx-auto" style="max-width:440px">
    <h1 class="h2">Đăng nhập</h1>
    <p>Đăng nhập bằng tài khoản được cấp để luyện tập và lưu kết quả.</p>
    @if (TempData["AccountMessage"] is string message) { <p class="alert alert-success" role="status">@message</p> }
    <form asp-controller="Account" asp-action="Login" method="post">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <input asp-for="ReturnUrl" type="hidden" />
        <div class="mb-3">
            <label asp-for="Username" class="form-label">Tên đăng nhập</label>
            <input asp-for="Username" class="form-control" autocomplete="username" />
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label">Mật khẩu</label>
            <input name="Password" id="Password" type="password" class="form-control" autocomplete="current-password" required />
        </div>
        <button type="submit" class="btn btn-primary">Đăng nhập</button>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
