<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Tra cứu, khám phá và luyện tập kiến thức tứ giác." />
    <title>@ViewData["Title"] · Tứ Giác Lab</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/app-theme.css" asp-append-version="true" />
</head>
<body class="app-body">
    <a class="app-skip" href="#main">Đến nội dung chính</a>
    <partial name="_AppNavigation" />
    <main id="main" class="container app-main">@RenderBody()</main>
    <partial name="_AppFooter" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
